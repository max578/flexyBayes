Package: flexyBayes
Title: Flexible Bayesian Mixed Models with ASReml and 'brms'-Style Syntax
Version: 0.3.0
Authors@R: c(
    person("Max", "Moldovan", email = "max.moldovan@gmail.com",
           role = c("aut", "cre"),
